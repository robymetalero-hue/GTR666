rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'robymetalero@gmail.com' ||
        request.auth.token.role == 'admin'
      );
    }

    function hasIntegrityProof() {
      return request.resource != null && request.resource.data != null && (
        request.resource.data.keys().hasAll(['_tx_hash', '_tx_timestamp']) ||
        request.resource.data.keys().hasAny(['initialized', 'admin_username', 'timestamp'])
      );
    }

    function isSandbox(coll) {
      return coll.matches('^sandbox_.*');
    }

    function isBlockedIncidentSaleId(docId) {
      return docId in ['437', '438', '439', '440'];
    }

    function hasValidNumericInvariants(coll, docId) {
      return !(coll == 'sales' && isBlockedIncidentSaleId(docId))
        && !(coll == 'products' && request.resource.data.keys().hasAny(['stock']) && request.resource.data.stock is number && request.resource.data.stock < 0)
        && !(coll == 'sales' && request.resource.data.keys().hasAny(['total']) && request.resource.data.total is number && request.resource.data.total < 0)
        && !(coll == 'accounts_receivable' && request.resource.data.keys().hasAny(['remaining_amount']) && request.resource.data.remaining_amount is number && request.resource.data.remaining_amount < -0.01);
    }

    // System sync state - client needs read to detect sync pulses
    match /system/{docId} {
      allow read, write: if true;
    }
    match /sandbox_system/{docId} {
      allow read, write: if true;
    }

    match /sync_metadata/{docId} {
      allow read, write: if true;
    }
    match /sandbox_sync_metadata/{docId} {
      allow read, write: if true;
    }

    // Security logs & admin activity auditing
    match /security_logs/{docId} {
      allow read, write: if true;
    }
    match /sandbox_security_logs/{docId} {
      allow read, write: if true;
    }

    // User accounts & security (Protected under Fase 4 rules)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if (isAuthenticated() || hasIntegrityProof());
      allow delete: if false;
    }
    match /sandbox_users/{userId} {
      allow read, write: if true;
    }

    match /usuarios/{userId} {
      allow read, write: if false;
    }

    // Internal System Settings - allows read of non-sensitive settings; writes require authentication or server integrity proof
    match /settings/{settingId} {
      allow read: if settingId != 'jwt_secret';
      allow create, update: if (isAuthenticated() || isSandbox('settings') || hasIntegrityProof()) && settingId != 'jwt_secret';
      allow delete: if false;
    }
    match /sandbox_settings/{settingId} {
      allow read: if settingId != 'jwt_secret';
      allow write: if settingId != 'jwt_secret';
    }

    // Sale Returns (Auditoría de Devoluciones - FASE 4)
    match /sale_returns/{returnId} {
      allow read: if isAuthenticated();
      allow create, update: if (isSandbox('sale_returns') || isAuthenticated() || hasIntegrityProof())
        && !(request.resource.data.keys().hasAny(['refund_amount']) && request.resource.data.refund_amount is number && request.resource.data.refund_amount < 0);
      allow delete: if isAdmin();
    }
    match /sandbox_sale_returns/{returnId} {
      allow read, write: if true;
    }

    // Audit logs & transaction ledger (Append-Only in Production)
    match /system_audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() || hasIntegrityProof();
      allow delete: if false;
    }
    match /sandbox_system_audit_logs/{logId} {
      allow read, write: if true;
    }

    match /firestore_transaction_ledger/{txId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() || hasIntegrityProof();
      allow delete: if false;
    }
    match /sandbox_firestore_transaction_ledger/{txId} {
      allow read, write: if true;
    }

    // Business Data collections (sales, inventory, clients, credits, caja, products)
    // Sandbox collections are isolated for dev testing; production writes accept integrity proof or authenticated server daemon
    match /{collectionName}/{docId} {
      allow read: if isSandbox(collectionName) || isAuthenticated() || collectionName in ['products', 'departments', 'deleted_records'];
      allow create, update: if (isSandbox(collectionName) || isAuthenticated() || hasIntegrityProof()) && hasValidNumericInvariants(collectionName, docId);
      allow delete: if isSandbox(collectionName) || isAuthenticated() || isAdmin();
    }
  }
}


